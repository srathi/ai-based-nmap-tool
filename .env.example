SECRET_KEY=your-secret-key-here-change-in-production
DATABASE_URL=sqlite:///./data/scanner.db

# AI/LLM Provider (choose one)
# Option A: Groq (free, recommended)
# Sign up at https://console.groq.com to get an API key
GROQ_API_KEY=gsk-your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
# Option B: OpenAI
# OPENAI_API_KEY=sk-your-openai-key
# AI_MODEL=gpt-4o-mini

# AI provider: 'openai' uses LLM (auto-detected if GROQ_API_KEY set), 'rule' for rule-only
# AI_PROVIDER=rule

SCAN_TIMEOUT=600
MAX_CONCURRENT_SCANS=3
RATE_LIMIT_PER_MINUTE=10
LOG_LEVEL=INFO